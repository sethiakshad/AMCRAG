# ==============================================================================
# AMCRAG Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Person 4: CRAG Evaluator & Corrective Retrieval Configuration
# ------------------------------------------------------------------------------

# Model checkpoint for T5 Evaluator (Hugging Face repo ID or local directory)
# Default: Mindie/CRAG-Evaluator (or local path e.g. ./models/husky_crag)
CRAG_EVALUATOR_PATH=Mindie/CRAG-Evaluator

# Hardware device override ("cpu", "cuda", or leave blank for auto-detection)
CRAG_DEVICE=

# Confidence threshold above which evidence is judged CORRECT (δ_upper)
CRAG_UPPER_THRESHOLD=0.65

# Confidence threshold below which evidence is judged INCORRECT (δ_lower)
CRAG_LOWER_THRESHOLD=0.30

# Policy for ambiguous evidence: retry_once | accept_with_qualification | strict_correction
CRAG_AMBIGUOUS_POLICY=retry_once

# Minimum number of candidates required above upper_threshold for a decisive CORRECT
CRAG_MIN_RELEVANT_CANDIDATES=1

# Weight given to peak scoring candidate vs top-k average in aggregate score (0.0 to 1.0)
CRAG_PEAK_SCORE_WEIGHT=0.7

# Maximum correction retry attempts allowed per query before stopping
CRAG_MAX_ATTEMPTS=2

# Query reformulation behavior flags
CRAG_STRIP_PREFIXES=true
CRAG_DETECT_VISUAL=true

# ------------------------------------------------------------------------------
# Person 5: Answer Generation & Google Gemini LLM Configuration
# ------------------------------------------------------------------------------

# Google Gemini API Key (Required for live Gemini LLM generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# LLM Provider selection ("ollama", "gemini", "openai", or "mock")
LLM_PROVIDER=ollama

# Gemini model identifier (e.g. "gemini-1.5-flash", "gemini-1.5-pro", "gemini-3.8-flash")
GEMINI_MODEL=gemini-1.5-flash

# Ollama Cloud API Key & Model Configuration
# Get your API key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com

# Generation temperature (0.0 to 1.0; low value enforces factual citations)
LLM_TEMPERATURE=0.2

# Maximum output tokens for generated answer
LLM_MAX_TOKENS=2048

